{"file":"state.test.ts","test":"vm > a failure in a for...of body closes the iterator and keeps the failure","seq":2,"via":"codemode","code":"\n        const log = []\n        const iterable = { [Symbol.iterator]() {\n          let i = 0\n          return { next: () => ({ done: i > 3, value: i++ }), return: () => { log.push(\"closed\"); return {} } }\n        } }\n        const check = (x) => { if (x === 2) throw new Error(\"at \" + x) }\n        try { for (const x of iterable) { log.push(x); check(x) } } catch (e) { log.push(e.message) }\n        for (const x of iterable) { if (x === 1) break }\n        return log\n      ","limits":{},"hooks":[],"extensions":[],"tree":{"children":[["echo",{"children":[],"tool":{"description":"Echo a value","input":{"kind":"effect","document":{"dialect":"draft-2020-12","schema":{"type":"object","properties":{"value":{"anyOf":[{"type":"number"},{"type":"string","enum":["Infinity","-Infinity","NaN"]}]}},"required":["value"],"additionalProperties":false},"definitions":{}},"emptyDocument":{"type":"object","properties":{"value":{"anyOf":[{"type":"number"},{"type":"string","enum":["Infinity","-Infinity","NaN"]}]}},"required":["value"],"additionalProperties":true}},"output":{"kind":"effect","document":{"dialect":"draft-2020-12","schema":{"anyOf":[{"type":"number"},{"type":"string","enum":["Infinity","-Infinity","NaN"]}]},"definitions":{}}},"signature":"tools.echo({\n  value: number,\n}): Promise<number>","inputTs":"{ value: number }","outputTs":"number","emptyInput":false,"inputProperties":[{"name":"value","description":{"$undefined":true},"required":true}]}}]]},"events":[],"result":{"ok":true,"value":[0,1,2,"closed","at 2","closed"],"toolCalls":[]}}
